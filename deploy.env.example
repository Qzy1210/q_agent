# 部署配置文件
# 请复制此文件为 deploy.env 并填写实际配置
# cp deploy.env.example deploy.env

# ==================== 服务器配置 ====================
# 服务器IP地址
SERVER_HOST=your_server_ip

# SSH用户名
SERVER_USER=root

# SSH端口
SERVER_PORT=22

# ==================== 部署路径 ====================
# 部署根目录
DEPLOY_BASE=/opt/aipro

# ==================== 服务端口 ====================
# WebSocket服务端口
WEBSOCKET_PORT=8088

# Q-Agent API端口
QAGENT_PORT=8089

# ==================== MySQL配置 ====================
# q_agent 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=q_agent

# WebSocket Platform 数据库配置 (如果与q_agent不同)
WS_MYSQL_HOST=localhost
WS_MYSQL_PORT=3306
WS_MYSQL_USER=root
WS_MYSQL_PASSWORD=your_mysql_password
WS_MYSQL_DATABASE=websocket_platform

# ==================== LLM配置 ====================
# LLM 提供商: openai, anthropic, ollama
LLM_PROVIDER=openai

# 模型名称
LLM_MODEL=gpt-3.5-turbo

# API Key (必填)
LLM_API_KEY=your_api_key_here

# Base URL (可选，用于Ollama或其他兼容API)
# LLM_BASE_URL=http://localhost:11434

# ==================== 其他配置 ====================
# Go版本
GO_VERSION=1.21.6

# Python版本
PYTHON_VERSION=3.10