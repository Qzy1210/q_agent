{
  "database": {
    "host": "localhost",
    "port": 3306,
    "user": "root",
    "password": "",
    "database": "q_agent",
    "charset": "utf8mb4",
    "pool_size": 5,
    "max_overflow": 10
  },
  "llm": {
    "provider": "openai",
    "model": "gpt-3.5-turbo",
    "api_key": "",
    "temperature": 0.7,
    "max_tokens": 2000,
    "base_url": "http://localhost:11434"
  },
  "agent": {
    "max_iterations": 10,
    "timeout": 300,
    "memory_size": 20,
    "context_window": 4000
  },
  "log": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/q_agent.log"
  },
  "debug": false
}
